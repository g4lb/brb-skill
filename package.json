{
  "name": "brb-claude-code",
  "version": "1.0.0-rc.1",
  "description": "BRB \u2014 Be Right Back. Pause and resume Claude Code sessions with structured, local checkpoints.",
  "license": "MIT",
  "author": "g4lb <galevgi@gmail.com>",
  "homepage": "https://github.com/g4lb/brb-skill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g4lb/brb-skill.git"
  },
  "bugs": {
    "url": "https://github.com/g4lb/brb-skill/issues"
  },
  "type": "module",
  "private": true,
  "bin": {
    "brb": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "skills",
    "hooks",
    ".claude-plugin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.json",
    "build:test": "node scripts/clean.mjs build && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && npm run build:test && node --test --test-concurrency=1 \"build/tests/unit/**/*.test.js\" \"build/tests/integration/**/*.test.js\"",
    "test:unit": "npm run build:test && node --test \"build/tests/unit/**/*.test.js\"",
    "test:e2e": "npm run build && bash tests/e2e/claude-e2e.sh",
    "verify:dist": "node scripts/verify-dist.mjs",
    "validate:plugin": "claude plugin validate . --strict",
    "check": "npm run typecheck && npm run lint && npm test && npm run verify:dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
