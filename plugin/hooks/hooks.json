{
  "description": "BRB lifecycle hooks. Each hook exits immediately unless Auto-BRB (or the resume hint) is enabled in BRB's config.",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/brb/scripts/brb.mjs\" hook pre-compact", "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/brb/scripts/brb.mjs\" hook session-end", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/brb/scripts/brb.mjs\" hook session-start", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite|TaskUpdate",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/brb/scripts/brb.mjs\" hook post-tool-use", "timeout": 10 }
        ]
      }
    ]
  }
}
