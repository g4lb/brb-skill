{
  "description": "BRB lifecycle hooks. Each hook exits immediately unless Auto-BRB (or the resume hint) is enabled in BRB's config.",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/brb/scripts/brb.mjs\" hook pre-compact",
            "timeout": 30,
            "statusMessage": "⏸ BRB · tucking your work into a checkpoint before compaction…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/brb/scripts/brb.mjs\" hook session-end",
            "timeout": 10,
            "statusMessage": "⏸ BRB · bookmarking this session on the way out…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/brb/scripts/brb.mjs\" hook session-start",
            "timeout": 10,
            "statusMessage": "▶ BRB · looking for where you left off…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/brb/scripts/brb.mjs\" hook post-tool-use",
            "timeout": 10,
            "statusMessage": "✓ BRB · checking for a milestone…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(node *brb.mjs*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/brb/scripts/brb.mjs\" hook post-bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
